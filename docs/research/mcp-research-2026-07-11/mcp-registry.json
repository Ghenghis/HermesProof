{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "HermesProof Agentic Toolkit Registry",
  "version": "2026-07-11",
  "registry_dir": ".hermesproof/mcp-registry",
  "skills_dir": ".hermesproof/skills",
  "rules": {
    "chrome_canary_only": true,
    "chrome_canary_profile": "C:\\ChromeCanary_KiloProof",
    "bun_pin": "1.13.x",
    "no_overwrite_custom_config": true,
    "require_evidence_before_release": true,
    "default_enabled": false
