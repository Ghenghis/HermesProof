    {
      "id": "coding",
      "name": "HermesProof Agentic Coding",
      "description": "Daily code, plan, test, review, and debug workflow.",
      "items": [
        "brainstorming",
        "writing-plans",
        "executing-plans",
        "subagent-driven-development",
        "test-driven-development",
        "requesting-code-review",
        "receiving-code-review",
        "verification-before-completion",
        "systematic-debugging",
        "using-git-worktrees",
        "finishing-a-development-branch",
        "writing-skills",
        "using-superpowers",
        "desktopcommander",
        "wcgw",
        "mcp-server-git",
        "mcp-server-filesystem",
        "github-mcp",
        "gitlab-mcp"
      ]
